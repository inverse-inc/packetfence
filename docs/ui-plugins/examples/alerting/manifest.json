{
  "manifestVersion": 1,
  "id": "alerting",
  "title": { "en": "Alerting (plugin)", "fr": "Alertes (plugin)" },
  "menu": { "area": "configuration", "section": "/configuration/system_configuration", "group": "Main Configuration", "can": "read configuration_main" },
  "template": "resource",
  "api": {
    "item": "config/base/alerting",
    "itemOptions": "config/base/alerting",
    "update": "config/base/alerting"
  },
  "form": {
    "tabs": [
      {
        "title": { "en": "Email", "fr": "Courriel" },
        "fields": [
          { "namespace": "emailaddr", "component": "BaseFormGroupTextarea", "label": { "en": "Recipients", "fr": "Destinataires" },
            "text": { "en": "Comma-separated list of email addresses." },
            "validators": [ { "fn": "isEmailCsv" } ] },
          { "namespace": "fromaddr", "component": "BaseFormGroupInput", "label": { "en": "Sender address" },
            "validators": [ { "fn": "email" } ] }
        ]
      },
      {
        "title": { "en": "SMTP" },
        "fields": [
          { "namespace": "smtpserver", "component": "BaseFormGroupInput", "label": { "en": "SMTP server" },
            "validators": [ { "fn": "isFQDN" } ] },
          { "namespace": "smtp_port", "component": "BaseFormGroupInputNumber", "label": { "en": "SMTP port" },
            "validators": [ { "fn": "minAsInt", "args": [0] }, { "fn": "maxAsInt", "args": [65535] } ] },
          { "namespace": "smtp_verifyssl", "component": "BaseFormGroupSwitch", "label": { "en": "SMTP Check SSL" },
            "props": { "enabledValue": "enabled", "disabledValue": "disabled" } }
        ]
      }
    ]
  }
}
