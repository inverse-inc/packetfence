{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetfence.org/schemas/ui-plugin-manifest.schema.json",
  "title": "PacketFence admin UI plugin manifest",
  "description": "Generated from html/pfappserver/root/src/plugins/catalog.json by html/pfappserver/root/build/ui-plugins-catalog.js, do not edit. The API also checks that every validator applies to the type of its component, that \"when\" references another field and that \"can\" is nested 3 levels at most. See docs/ui-plugins/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "title",
    "menu",
    "template",
    "api",
    "form"
  ],
  "properties": {
    "manifestVersion": {
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$",
      "description": "The name the plugin service registered with."
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "can"
      ],
      "properties": {
        "area": {
          "enum": [
            "configuration",
            "status",
            "auditing",
            "nodes",
            "users",
            "preferences"
          ]
        },
        "section": {
          "type": "string",
          "description": "Path of an existing sidebar section of the area, without it the item is a new section."
        },
        "group": {
          "type": "string",
          "description": "Untranslated name of a group of the section."
        },
        "before": {
          "type": "string",
          "description": "Path of a sidebar item to insert before."
        },
        "after": {
          "type": "string",
          "description": "Path of a sidebar item to insert after."
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$",
          "description": "A vue-awesome icon already used by core, for a new section."
        },
        "can": {
          "$ref": "#/$defs/can",
          "description": "The ACL needed to see the item and its pages, and to call the plugin (checked by the API on every call), eg: \"read system\"."
        }
      }
    },
    "template": {
      "enum": [
        "resource",
        "collection"
      ]
    },
    "api": {
      "type": "object",
      "description": "The API of the page, as in the _api.js of the core views: a path relative to /api/v1/plugin/<id>/ (the plugin service) by method, called with a fixed verb (list: GET, listOptions: OPTIONS, search: POST, create: POST, item: GET, itemOptions: OPTIONS, update: PATCH, delete: DELETE). A missing method is not offered by the page."
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                "not": {
                  "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
                },
                "description": "A property of the item, dots for nested ones (not __proto__, constructor or prototype)."
              },
              "label": {
                "$ref": "#/$defs/text"
              },
              "sortable": {
                "type": "boolean"
              }
            }
          }
        },
        "searchFields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
            "not": {
              "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
            },
            "description": "A property of the item, dots for nested ones (not __proto__, constructor or prototype)."
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "tabs"
          ]
        }
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "fields"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/text"
              },
              "can": {
                "$ref": "#/$defs/can"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/field"
                }
              }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "template": {
        "const": "collection"
      }
    }
  },
  "then": {
    "required": [
      "collection"
    ],
    "properties": {
      "api": {
        "$ref": "#/$defs/apiCollection"
      }
    }
  },
  "else": {
    "not": {
      "required": [
        "collection"
      ]
    },
    "properties": {
      "api": {
        "$ref": "#/$defs/apiResource"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "description": "A translatable text, by language, \"en\" is required.",
      "required": [
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2}([_-][A-Za-z]{2})?$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "can": {
      "description": "The ACL an admin needs, as acl.$can, acl.$some and acl.$every: \"<verb> <target>\", { \"some\": [can, ...] } or { \"every\": [can, ...] }.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(create|create-overwrite|create-multiple|delete|mark-as-sponsor|probe|read|read-sponsored|set-access-level|set-access-duration|set-bandwidth-balance|set-role|set-time-balance|set-unreg-date|trigger-radius-mfa|trigger-portal-mfa|update|write|master|access) [a-z][a-z0-9_]*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "some"
          ],
          "properties": {
            "some": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/can"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "every"
          ],
          "properties": {
            "every": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/can"
              }
            }
          }
        }
      ]
    },
    "apiCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item"
      ],
      "properties": {
        "list": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "GET path without {id}",
          "not": {
            "pattern": "\\{id\\}"
          }
        },
        "listOptions": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "OPTIONS path without {id}",
          "not": {
            "pattern": "\\{id\\}"
          }
        },
        "search": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "POST path without {id}",
          "not": {
            "pattern": "\\{id\\}"
          }
        },
        "create": {
          "description": "POST path without {id} as { path, can }: the ACL needed to offer it, also checked by the API on every call",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "can"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
              "description": "POST path without {id}",
              "not": {
                "pattern": "\\{id\\}"
              }
            },
            "can": {
              "$ref": "#/$defs/can"
            }
          }
        },
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "GET path with {id}",
          "allOf": [
            {
              "pattern": "\\{id\\}"
            },
            {
              "not": {
                "pattern": "\\{id\\}.*\\{id\\}"
              }
            }
          ]
        },
        "itemOptions": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "OPTIONS path with {id}",
          "allOf": [
            {
              "pattern": "\\{id\\}"
            },
            {
              "not": {
                "pattern": "\\{id\\}.*\\{id\\}"
              }
            }
          ]
        },
        "update": {
          "description": "PATCH path with {id} as { path, can }: the ACL needed to offer it, also checked by the API on every call",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "can"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
              "description": "PATCH path with {id}",
              "allOf": [
                {
                  "pattern": "\\{id\\}"
                },
                {
                  "not": {
                    "pattern": "\\{id\\}.*\\{id\\}"
                  }
                }
              ]
            },
            "can": {
              "$ref": "#/$defs/can"
            }
          }
        },
        "delete": {
          "description": "DELETE path with {id} as { path, can }: the ACL needed to offer it, also checked by the API on every call",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "can"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
              "description": "DELETE path with {id}",
              "allOf": [
                {
                  "pattern": "\\{id\\}"
                },
                {
                  "not": {
                    "pattern": "\\{id\\}.*\\{id\\}"
                  }
                }
              ]
            },
            "can": {
              "$ref": "#/$defs/can"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "list"
          ]
        },
        {
          "required": [
            "search"
          ]
        }
      ]
    },
    "apiResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item"
      ],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "GET path without {id}",
          "not": {
            "pattern": "\\{id\\}"
          }
        },
        "itemOptions": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
          "description": "OPTIONS path without {id}",
          "not": {
            "pattern": "\\{id\\}"
          }
        },
        "update": {
          "description": "PATCH path without {id} as { path, can }: the ACL needed to offer it, also checked by the API on every call",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "can"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+(/([a-z0-9_.-]+|\\{id\\}))*$",
              "description": "PATCH path without {id}",
              "not": {
                "pattern": "\\{id\\}"
              }
            },
            "can": {
              "$ref": "#/$defs/can"
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "component"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          },
          "description": "A property of the item, dots for nested ones (not __proto__, constructor or prototype)."
        },
        "component": {
          "enum": [
            "BaseFormGroupInput",
            "BaseFormGroupInputNumber",
            "BaseFormGroupInputPassword",
            "BaseFormGroupInputPasswordGenerator",
            "BaseFormGroupTextarea",
            "BaseFormGroupInputDate",
            "BaseFormGroupInputDateTime",
            "BaseFormGroupChosenOne",
            "BaseFormGroupChosenOneSearchable",
            "BaseFormGroupChosenTimezone",
            "BaseFormGroupChosenCountry",
            "BaseFormGroupChosenMultiple",
            "BaseFormGroupChosenMultipleSearchable",
            "BaseFormGroupSwitch",
            "BaseFormGroupToggle",
            "BaseFormGroupToggleDisabledEnabled",
            "BaseFormGroupToggleNoYes",
            "BaseFormGroupToggleNY",
            "BaseFormGroupToggleOffOn",
            "BaseFormGroupToggleFalseTrue"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "placeholder": {
          "$ref": "#/$defs/text"
        },
        "props": {
          "type": "object",
          "description": "Other properties of the component (eg: options, enabledValue). Not namespace, columnLabel, text, placeholder, textFn, apiFeedback, invalidFeedback, validFeedback.",
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespace"
                ]
              },
              {
                "required": [
                  "columnLabel"
                ]
              },
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "placeholder"
                ]
              },
              {
                "required": [
                  "textFn"
                ]
              },
              {
                "required": [
                  "apiFeedback"
                ]
              },
              {
                "required": [
                  "invalidFeedback"
                ]
              },
              {
                "required": [
                  "validFeedback"
                ]
              }
            ]
          }
        },
        "can": {
          "$ref": "#/$defs/can",
          "description": "The ACL needed to see the field."
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "oneOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "notEquals"
              ]
            },
            {
              "required": [
                "in"
              ]
            }
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
              "not": {
                "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
              },
              "description": "A property of the item, dots for nested ones (not __proto__, constructor or prototype)."
            },
            "equals": {},
            "notEquals": {},
            "in": {
              "type": "array"
            }
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validator"
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fn"
      ],
      "properties": {
        "fn": {
          "enum": [
            "required",
            "min",
            "max",
            "matches",
            "email",
            "url",
            "in",
            "not",
            "minAsInt",
            "maxAsInt",
            "isAlphaNumeric",
            "isAlphaNumericHyphenUnderscoreDot",
            "isUUID",
            "isCIDR",
            "isCommonName",
            "isCommonNameOrFQDN",
            "isCommonNameOrFQDNOrMAC",
            "isDomain",
            "isEmailCsv",
            "isFilename",
            "isFQDN",
            "isLowerCase",
            "isHostname",
            "isIpv4",
            "isIpv4Csv",
            "isIpv6",
            "isMAC",
            "isPort",
            "isPortCsv",
            "isPrice",
            "isStaticRoute",
            "isVLAN",
            "unique"
          ]
        },
        "args": {
          "type": "array"
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fn": {
                "const": "required"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "min"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "max"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "matches"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "maxLength": 256,
                    "description": "At most 256 characters, no nested quantifiers."
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "email"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "url"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "in"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "array"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "not"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "minAsInt"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "maxAsInt"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isAlphaNumeric"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isAlphaNumericHyphenUnderscoreDot"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isUUID"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isCIDR"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isCommonName"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isCommonNameOrFQDN"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fn": {
                "const": "isCommonNameOrFQDNOrMAC"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 0
              }
