#!/bin/bash

# Create the Kafka topics PacketFence consumes, once the broker answers.
#
# pfflow must not join its consumer group before pfflows_events exists: Kafka
# then gives it no partition and, with no other member in the group, never
# rebalances (INV-948). Without this the topic only appears when the first
# flow is exported. The topic is created with the broker defaults for the
# partition count and replication factor, exactly as auto-creation would.
#
# Run as ExecStartPost of packetfence-kafka.service; it gives up after
# KAFKA_CREATE_TOPICS_TIMEOUT seconds so it stays within the unit's start
# timeout, and pfflow still waits for the topic on its own if it fails.

name=kafka
bootstrap=localhost:9095
timeout=${KAFKA_CREATE_TOPICS_TIMEOUT:-75}

topic=$(/bin/perl -I/usr/local/pf/lib -I/usr/local/pf/lib_perl/lib/perl5 '-Mpf::config::pfcron=%ConfigCron' -e 'print $ConfigCron{pfflow}{read_topic} // ""' 2>/dev/null)
topic=${topic:-pfflows_events}

deadline=$((SECONDS + timeout))
until timeout 30 docker exec $name kafka-topics --bootstrap-server $bootstrap --create --if-not-exists --topic "$topic" >/dev/null 2>&1; do
  if (( SECONDS >= deadline )); then
    echo "Unable to create Kafka topic $topic within ${timeout}s" >&2
    exit 1
  fi

  sleep 2
done

echo "Kafka topic $topic is present"
