#!/bin/sh
# postinst script for packetfence-ntlm-auth-api
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE

case "$1" in
    configure)
    # get containers image and tag them locally
    /usr/local/ntlm-auth-api/containers/manage-images.sh
    /bin/systemctl daemon-reload
    /bin/systemctl enable packetfence-ntlm-auth-api-remote.service
    if [ -n "$2" ]; then
        echo "Upgrade detected, restarting packetfence-ntlm-auth-api-remote service"
        # --no-block: don't make dpkg wait on (and report) the first start. During an
        # upgrade the pfconnector-remote-combined container was just restarted and its
        # tunnel (:22226 / credcache forward) can take up to 120s to be ready, while the
        # combined unit is Type=simple so our After= is satisfied long before that. The
        # forking PIDFile is only written once a domain container answers /ping, so the
        # first start would block to the 90s timeout and fail. Restart=on-failure brings
        # it up cleanly once the tunnel is ready.
        /bin/systemctl restart --no-block packetfence-ntlm-auth-api-remote.service || \
            echo "Warning: failed to enqueue restart of packetfence-ntlm-auth-api-remote.service (will retry via Restart=on-failure)"
    else
        /bin/systemctl stop packetfence-ntlm-auth-api-remote.service
    fi

    if ! grep -qE '^100\.64\.0\.1[[:space:]]+containers-gateway\.internal([[:space:]]|$)' /etc/hosts; then
        # Drop any stale mapping (e.g. the old 127.0.0.1 loopback entry) before adding the connector gateway one
        sed -i -E '/[[:space:]]containers-gateway\.internal([[:space:]]|$)/d' /etc/hosts
        echo "" >> /etc/hosts
        echo "100.64.0.1 containers-gateway.internal" >> /etc/hosts
    fi
    
    echo "NTLM Auth API installation completed"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
