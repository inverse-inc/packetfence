#!/bin/sh
# postinst script for packetfence-ntlm-auth-join-remote
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE

case "$1" in
    configure)
    # get containers image and tag them locally
    /usr/local/ntlm-auth-api/containers/manage-images.sh
    /bin/systemctl daemon-reload
    /bin/systemctl enable packetfence-ntlm-auth-join-remote.service
    if [ -n "$2" ]; then
        echo "Upgrade detected, restarting packetfence-ntlm-auth-join-remote service"
        # --no-block: don't make dpkg wait on (and report) the first start. During an
        # upgrade the pfconnector-remote-combined container was just restarted and its
        # tunnel can take up to 120s to be ready, while the combined unit is Type=simple
        # so our After= is satisfied long before that. The first start would block to the
        # timeout and fail; Restart=on-failure brings it up cleanly once the tunnel is ready.
        /bin/systemctl restart --no-block packetfence-ntlm-auth-join-remote.service || \
            echo "Warning: failed to enqueue restart of packetfence-ntlm-auth-join-remote.service (will retry via Restart=on-failure)"
    else
        /bin/systemctl stop packetfence-ntlm-auth-join-remote.service 2>/dev/null || true
    fi

    echo "NTLM Auth Join Remote installation completed"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
