#!/bin/sh
# postinst script for packetfence-pfconnector
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE

case "$1" in
    configure)
    if [ ! -f /usr/local/pfconnector-remote/raddb/certs/server.pem ]; then
        make -C /usr/local/pfconnector-remote/raddb/certs
    fi
    cp /usr/local/pfconnector-remote/raddb/sites-available/status /usr/local/pfconnector-remote/raddb/sites-enabled/status
    /usr/local/pfconnector-remote/upgrade/remove-unpackaged-pfconnector.sh
    # The bundled /etc/docker/daemon.json sets the docker0 bridge IP (bip) to
    # 100.64.0.1/24, but docker only applies it on (re)start. Restart docker if
    # docker0 isn't already on that address so the connector containers and the
    # containers-gateway.internal mapping resolve correctly.
    if ! ip -4 -o addr show docker0 2>/dev/null | grep -qF 'inet 100.64.0.1/24'; then
        echo "Restarting docker to apply docker0 bridge IP 100.64.0.1"
        /bin/systemctl restart docker
    fi
    # get containers image and tag them locally
    /usr/local/pfconnector-remote/containers/manage-images.sh
    # stop and disable legacy pfconnector-remote service in favor of the combined one
    if systemctl is-enabled --quiet "packetfence-pfconnector-remote.service" 2>/dev/null; then
        /bin/systemctl stop packetfence-pfconnector-remote.service 2>/dev/null || true
        /bin/systemctl disable packetfence-pfconnector-remote.service 2>/dev/null || true
    fi
    /bin/systemctl daemon-reload
    /bin/systemctl enable packetfence-pfconnector-remote-combined.service
    # Watches conf/upgrade_requested for admin-triggered upgrades from the
    # PacketFence admin interface
    /bin/systemctl enable packetfence-pfconnector-upgrade.path
    /bin/systemctl start packetfence-pfconnector-upgrade.path || true

    # Installs configured before the remote terminal existed lack its
    # toggles in pfconnector-client.env (configure.sh only runs at initial
    # setup): default them to enabled on upgrade, before the service
    # restart below so the restarted connector picks them up.
    ENV_FILE=/usr/local/pfconnector-remote/conf/pfconnector-client.env
    if [ -f "$ENV_FILE" ]; then
        # Guard against a missing trailing newline before appending
        if [ -s "$ENV_FILE" ] && [ -n "$(tail -c1 "$ENV_FILE")" ]; then
            echo "" >> "$ENV_FILE"
        fi
        if ! grep -q '^PFCONNECTOR_TERMINAL=' "$ENV_FILE"; then
            echo "PFCONNECTOR_TERMINAL=true" >> "$ENV_FILE"
        fi
        if ! grep -q '^PFCONNECTOR_TERMINAL_TOTP=' "$ENV_FILE"; then
            echo "PFCONNECTOR_TERMINAL_TOTP=true" >> "$ENV_FILE"
        fi
    fi

    # Generate the TOTP seed gating remote terminal access (validated by the
    # pfconnector-client, kept in conf/terminal_totp) and display it as a QR
    # code to enroll in an authenticator app. Only on first generation, so
    # upgrades stay quiet once the seed exists. Done before the service
    # restart below so the connector loads this seed instead of generating
    # its own. 20 random bytes make a padding-free base32 secret, the same
    # otpauth format the client would generate on first start if this file
    # were missing.
    TOTP_FILE=/usr/local/pfconnector-remote/conf/terminal_totp
    if [ ! -s "$TOTP_FILE" ]; then
        TOTP_SECRET=$(head -c 20 /dev/urandom | base32 | tr -d '=\n')
        echo "otpauth://totp/PacketFence%20pfconnector:$(hostname)?algorithm=SHA1&digits=6&issuer=PacketFence%20pfconnector&period=30&secret=${TOTP_SECRET}" > "$TOTP_FILE"
        chmod 600 "$TOTP_FILE"
        echo ""
        echo "=================================================================="
        echo "Opening a remote terminal on this connector from the PacketFence"
        echo "admin interface requires a TOTP code. Enroll this connector in an"
        echo "authenticator app now:"
        echo ""
        if command -v qrencode > /dev/null 2>&1; then
            qrencode -t ansiutf8 "$(cat "$TOTP_FILE")"
            echo ""
        else
            echo "(install the qrencode package to display this as a QR code)"
        fi
        echo "otpauth URL (kept in $TOTP_FILE):"
        cat "$TOTP_FILE"
        echo ""
        echo "Run /usr/local/pfconnector-remote/bin/pfconnector-totp-qrcode to display this QR code again."
        echo "=================================================================="
    fi

    if [ -n "$2" ]; then
        if systemctl is-active --quiet "packetfence-pfconnector-remote-combined.service"; then
            echo "Upgrade detected, restarting packetfence-pfconnector-remote-combined service"
            /bin/systemctl restart packetfence-pfconnector-remote-combined.service
        fi
    else
        /bin/systemctl stop packetfence-pfconnector-remote-combined.service
    fi

    if ! grep -qE '^100\.64\.0\.1[[:space:]]+containers-gateway\.internal([[:space:]]|$)' /etc/hosts; then
        # Drop any stale mapping (e.g. the old 127.0.0.1 loopback entry) before adding the connector gateway one
        sed -i -E '/[[:space:]]containers-gateway\.internal([[:space:]]|$)/d' /etc/hosts
        echo "" >> /etc/hosts
        echo "100.64.0.1 containers-gateway.internal" >> /etc/hosts
    fi
    
    echo ""
    echo "Connector installation completed"
    echo ""
    echo "Run /usr/local/pfconnector-remote/bin/pfconnector-configure to setup the pfconnector-remote"
    echo ""
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
