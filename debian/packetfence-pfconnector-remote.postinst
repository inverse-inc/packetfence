#!/bin/sh
# postinst script for packetfence-pfconnector
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE

case "$1" in
    configure)
    # The raddb config now lives inside the container image and certs are
    # generated at container start into /usr/local/pfconnector-remote/certs.
    # Migrate certs generated by older packages so the EAP/RadSec identity is
    # preserved, then drop the leftover host raddb (no longer packaged).
    if [ -f /usr/local/pfconnector-remote/raddb/certs/server.pem ] && [ ! -f /usr/local/pfconnector-remote/certs/server.pem ]; then
        mkdir -p /usr/local/pfconnector-remote/certs
        cp -a /usr/local/pfconnector-remote/raddb/certs/. /usr/local/pfconnector-remote/certs/
    fi
    rm -rf /usr/local/pfconnector-remote/raddb
    # Leftovers from older packages that fetched the config onto the host
    rm -rf /usr/local/pfconnector-remote/conf/ssl /usr/local/pfconnector-remote/conf/log.conf.d
    /usr/local/pfconnector-remote/upgrade/remove-unpackaged-pfconnector.sh
    # The bundled /etc/docker/daemon.json sets the docker0 bridge IP (bip) to
    # 100.64.0.1/24, but docker only applies it on (re)start. Restart docker if
    # docker0 isn't already on that address so the connector containers and the
    # containers-gateway.internal mapping resolve correctly.
    if ! ip -4 -o addr show docker0 2>/dev/null | grep -qF 'inet 100.64.0.1/24'; then
        echo "Restarting docker to apply docker0 bridge IP 100.64.0.1"
        /bin/systemctl restart docker
    fi
    # get containers image and tag them locally
    /usr/local/pfconnector-remote/containers/manage-images.sh
    # stop and disable legacy pfconnector-remote service in favor of the combined one
    if systemctl is-enabled --quiet "packetfence-pfconnector-remote.service" 2>/dev/null; then
        /bin/systemctl stop packetfence-pfconnector-remote.service 2>/dev/null || true
        /bin/systemctl disable packetfence-pfconnector-remote.service 2>/dev/null || true
    fi
    /bin/systemctl daemon-reload
    /bin/systemctl enable packetfence-pfconnector-remote-combined.service
    if [ -n "$2" ]; then
        if systemctl is-active --quiet "packetfence-pfconnector-remote-combined.service"; then
            echo "Upgrade detected, restarting packetfence-pfconnector-remote-combined service"
            /bin/systemctl restart packetfence-pfconnector-remote-combined.service
        fi
    else
        /bin/systemctl stop packetfence-pfconnector-remote-combined.service
    fi

    if ! grep -qE '^100\.64\.0\.1[[:space:]]+containers-gateway\.internal([[:space:]]|$)' /etc/hosts; then
        # Drop any stale mapping (e.g. the old 127.0.0.1 loopback entry) before adding the connector gateway one
        sed -i -E '/[[:space:]]containers-gateway\.internal([[:space:]]|$)/d' /etc/hosts
        echo "" >> /etc/hosts
        echo "100.64.0.1 containers-gateway.internal" >> /etc/hosts
    fi
    
    echo ""
    echo "Connector installation completed"
    echo ""
    echo "Run /usr/local/pfconnector-remote/bin/pfconnector-configure to setup the pfconnector-remote"
    echo ""
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
