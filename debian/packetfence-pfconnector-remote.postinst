#!/bin/sh
# postinst script for packetfence-pfconnector
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE

case "$1" in
    configure)
    if ! grep -q "containers-gateway.internal" /etc/hosts; then
        echo "127.0.0.1 containers-gateway.internal" >> /etc/hosts
    fi
    /usr/local/pfconnector-remote/upgrade/remove-unpackaged-pfconnector.sh
    # get containers image and tag them locally
    /usr/local/pfconnector-remote/containers/manage-images.sh
    /bin/systemctl daemon-reload
    /bin/systemctl enable packetfence-pfconnector-remote.service
    /bin/systemctl enable packetfence-radiusd-auth.service
    if [ -n "$2" ]; then
        if systemctl is-active --quiet "packetfence-pfconnector-remote.service"; then
            echo "Upgrade detected, restarting packetfence-pfconnector-remote service"
            /bin/systemctl restart packetfence-pfconnector-remote.service
        fi
        if systemctl is-active --quiet "packetfence-radiusd-auth.service"; then
            echo "Upgrade detected, restarting packetfence-radiusd-auth service"
            /bin/systemctl restart packetfence-radiusd-auth.service
        fi
    else
        /bin/systemctl stop packetfence-pfconnector-remote.service
	/bin/systemctl stop packetfence-radiusd-auth.service
    fi

    if ! grep 'containers-gateway.internal' /etc/hosts > /dev/null; then
        echo "" >> /etc/hosts
        echo "100.64.0.1 containers-gateway.internal" >> /etc/hosts
    fi
    
    echo "Connector installation completed"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
