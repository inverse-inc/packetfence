#!/bin/sh
set -e

# Configure GPG for non-interactive use
export GPG_TTY=$(tty 2>/dev/null || echo /dev/null)
mkdir -p ~/.gnupg
chmod 700 ~/.gnupg
cat > ~/.gnupg/gpg.conf <<EOF
batch
no-tty
pinentry-mode loopback
EOF
cat > ~/.gnupg/gpg-agent.conf <<EOF
allow-loopback-pinentry
default-cache-ttl 7200
max-cache-ttl 7200
EOF

# Import key + cache passphrase in one shot
echo "import the gpg private key" > /proc/1/fd/1
gpg --batch --pinentry-mode loopback \
    --passphrase "$GPG_OWN_KEY_PASSSWORD" \
    --import /var/run/git-crypt-key/git-crypt.key

# Pre-cache passphrase in gpg-agent so git-crypt doesn't prompt
gpg_key_id=$(gpg --list-keys --with-colons | awk -F: '/fpr:/ {print $10; exit}')
echo "5
y
" | gpg --batch --command-fd 0 --expert --edit-key "$gpg_key_id" trust 2>/dev/null || true

# Decrypt repository (passphrase already cached)
echo "decrypt repository" > /proc/1/fd/1
echo "$GPG_OWN_KEY_PASSSWORD" | git-crypt unlock 2>&1 || \
    GPG_PASSPHRASE="$GPG_OWN_KEY_PASSSWORD" git-crypt unlock
