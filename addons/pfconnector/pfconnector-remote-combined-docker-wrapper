#!/bin/bash

source /usr/local/pfconnector-remote/containers/systemd-service

name=pfconnector-remote-combined

args=`base_args $name`

# pfconnector-client env vars
args="$args --env-file /usr/local/pfconnector-remote/conf/pfconnector-client.env"
args="$args -eLOG_OUTPUT=stdout"
# Don't exit the container when a supervised service crashes
args="$args -eS6_BEHAVIOUR_IF_STAGE2_FAILS=0"
# Allow up to 120s for services to start (wait-for-pfconnector needs time)
args="$args -eS6_CMD_WAIT_FOR_SERVICES_MAXTIME=120000"

# The system_init_key may not exist on installs configured before it was
# introduced; create it so Docker doesn't turn the file mount into a directory
if [ ! -f /usr/local/pfconnector-remote/conf/system_init_key ]; then
  rm -rf /usr/local/pfconnector-remote/conf/system_init_key
  head -c 32 /dev/urandom | base64 > /usr/local/pfconnector-remote/conf/system_init_key
fi

# Cloud-reach configuration; everything else lives in the image or is fetched
# from the central server at container start
args="$args -v /usr/local/pfconnector-remote/conf/pfconnector-client.env:/usr/local/pf/conf/pfconnector-client.env"
args="$args -v /usr/local/pfconnector-remote/conf/system_init_key:/usr/local/pf/conf/system_init_key"

# Shared mounts
args="$args -v /usr/local/pfconnector-remote/logs:/usr/local/pf/logs"

# radiusd-auth generated certs (EAP/RadSec identity, persisted across container recreation)
args="$args -v /usr/local/pfconnector-remote/certs:/usr/local/pf/certs-persist"

# fingerbank-collector mounts
args="$args -v /usr/local/pfconnector-remote/db:/usr/local/collector-remote/db"

# connector-cache sqlite DB (persist across container restarts)
args="$args -v /usr/local/pfconnector-remote/var/lib/packetfence-connector-cache:/usr/local/packetfence-connector-cache"

args="$args --network=host"

run $name "$args"
