[upstream]
api_key =
host=api.fingerbank.org
port=443
use_https=enabled
db_path = /api/v2/download/db
sqlite_db_retention = 2

[collector]
host=[% ENV.env_or_default("FINGERBANK_COLLECTOR_SERVICE_HOST", "100.64.0.1") %]
port=[% ENV.env_or_default("FINGERBANK_COLLECTOR_SERVICE_PORT", "4723") %]
use_https=enabled
inactive_endpoints_expiration=168
arp_lookup=disabled
query_cache_time=1440
db_persistence_interval=60
cluster_resync_interval=120
network_behavior_analysis=disabled
additional_env=<<EOT
COLLECTOR_DISABLE_KAFKA=true
COLLECTOR_KAFKA_HOSTS=containers-gateway.internal:9095
COLLECTOR_DISABLE_IPFIX_SERVICE=true
COLLECTOR_DISABLE_SFLOW_SERVICE=true
EOT

[query]
record_unmatched = disabled

[proxy]
use_proxy = disabled
host =
port =
verify_ssl = enabled
