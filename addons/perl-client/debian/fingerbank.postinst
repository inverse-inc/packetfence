#!/bin/sh
# postinst script for fingerbank
#
# see: dh_installdeb(1)

# Source debconf library.
set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Force the LC_CTYPE to C to avoid i18n problems during postinstallation.
LC_CTYPE=C
export LC_CTYPE


case "$1" in
    configure)
        export FINGERBANK=/usr/local/fingerbank
        cd /usr/local/fingerbank
        # The local database was removed in 4.3.6
        rm -f /usr/local/fingerbank/db/fingerbank_Local.db
        make fixpermissions
        /usr/local/fingerbank/conf/upgrade/*
        chown fingerbank:fingerbank /usr/local/fingerbank/conf/fingerbank.conf
        # On an upgrade, flush the Fingerbank cache if running with PacketFence
        if [ -n "$2" ] && [ -x /usr/local/pf/bin/pfcmd ]; then
            /usr/local/pf/bin/pfcmd cache fingerbank clear || true
            echo "Cleared the PacketFence Fingerbank cache"
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
# vim: set shiftwidth=4:
# vim: set expandtab:
