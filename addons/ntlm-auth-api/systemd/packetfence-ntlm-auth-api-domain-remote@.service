[Unit]
Description=PacketFence NTLM auth Backend API For Domain %i Remote

[Service]
Type=notify
TimeoutStopSec=60
NotifyAccess=all
LimitNOFILE=8192
ExecStart=/usr/local/pf/ntlm-auth-api/ntlm-auth-api-domain %i
ExecStop=/bin/bash -c "docker stop ntlm-auth-api-%i; echo Stopped"
Restart=on-failure
Slice=packetfence.slice
PIDFile=/usr/local/ntlm-auth-api/var/run/ntlm-auth-api-%i-systemd-notify.pid
#EnvironmentFile=-/usr/local/pf/conf/log.conf.d/ntlm-auth-api.conf

[Install]
WantedBy=multi-user.target

