# conf/documentation.conf (fencing.range)
msgid ""
"Address ranges/CIDR blocks that PacketFence will monitor/detect/trap on.  "
"Gateway, network, and broadcast addresses are ignored. Comma-delimited "
"entries should be of the form <ul><li>a.b.c.0/24</li> <li>a.b.c.0-255</li> "
"<li>a.b.c.0-a.b.c.255</li> <li>a.b.c.d</li></ul>"
msgstr "PacketFence'in izleyeceği/tespit edeceği/tuzak kuracağı adres aralıkları / CIDR blokları.  Ağ geçidi, ağ ve yayın adresleri yok sayılır. Virgülle ayrılmış girişler şu şekilde olmalıdır; <ul><li>a.b.c.0/24</li> <li>a.b.c.0-255</li> <li>a.b.c.0-a.b.c.255</li> <li>a.b.c.d</li></ul>"

