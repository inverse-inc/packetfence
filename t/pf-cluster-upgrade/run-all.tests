#!/bin/bash
#
# Runs the pf-cluster-upgrade test suite.
#
# Copyright (C) 2005-2026 Inverse inc.
#
# Author: Inverse inc. <info@inverse.ca>
#
# Licensed under the GPL
#
set -o nounset -o pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
rc=0
for t in "${HERE}"/*.tests; do
    [ "$t" = "${HERE}/run-all.tests" ] && continue
    # stdin closed on purpose: two checks describe what happens without a
    # terminal and would otherwise measure the terminal they run on.
    bash "$t" </dev/null || rc=1
done
exit $rc
