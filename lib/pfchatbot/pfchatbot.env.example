# /usr/local/pf/conf/pfchatbot.env  (chmod 600)
# NOTE: docker --env-file has no inline-comment syntax. Comments on their own
# lines only, or the value includes the comment text.

# ── REQUIRED: provider (BYOK) ──
PROVIDER=openai
API_KEY=sk-REPLACE-ME
MODEL=gpt-4o

# ── REQUIRED: PacketFence API ──
PF_BASE_URL=https://localhost:9999/api/v1
PF_USERNAME=admin
PF_PASSWORD=REPLACE-ME
PF_VERIFY_TLS=false
PF_OPENAPI_FILE=/spec/openapi.json
# admin UI base, used for clickable navigation links
PF_ADMIN_URL=https://REPLACE-HOST:1443

# ── REQUIRED: conversation store (PF MariaDB over the mounted socket) ──
CHATBOT_DB_SOCKET=/var/lib/mysql/mysql.sock
CHATBOT_DB_NAME=pf
CHATBOT_DB_USER=pfchatbot
CHATBOT_DB_PASSWORD=REPLACE-ME

# ── REQUIRED: admin-proxy integration ──
CHATBOT_USER_HEADER=X-PacketFence-Username
CHATBOT_REQUIRE_WRITE_ACTION=1
# The AAA layer forwards admin ROLE NAMES in X-PacketFence-Admin-Roles
# (defaults in app.py match; override only for custom role names):
#CHATBOT_ROLES_HEADER=X-PacketFence-Admin-Roles
#CHATBOT_WRITE_GRANTS=CHATBOT_WRITE,CHATBOT-ADMIN,ALL,ALL_PF_ONLY

# ── REQUIRED: bind address ──
# EXPLICIT, always. auto picks the PF management IP; if that IP is public the
# bot is exposed to the internet with no auth in front of it. Use the IP that
# containers-gateway.internal resolves to inside PF's containers.
BIND_HOST=100.64.0.1
BIND_PORT=8800

# ── RAG ──
RAG_DOCS_DIR=/docs
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── tuning (defaults shown) ──
#LLM_TIMEOUT=180
#LLM_RETRIES=4
#TOOL_RESULT_MAX=12000
#HISTORY_CHAR_BUDGET=24000
#PF_LOG_DIR=/pflogs
#PF_TESTTOOL_SOCK=/run/pf-testtool/helper.sock
#DATA_DIR=/home/pfbot/.cache/pf-data
