{
	# Uncomment the 2 lines below if you want to enable pprof (example curl http://100.64.0.1:2022/debug/pprof/heap)
	admin off
	#admin :2022
	#debug
}

:22223 {
	route * {
		logger {
			level INFO
		}
		statsd {
			proto udp
			prefix pfipset
			address {$STATSD_ADDRESS}
		}
		pfipset
	}
}
