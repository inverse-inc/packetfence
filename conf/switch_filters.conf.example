# Copyright (C) Inverse inc.
# SWITCH FILTERS configuration
# ============================
#
# A switch filter changes the switch module or the switch configuration that
# PacketFence uses, when its condition matches.
#
# Scopes
# ------
# A rule applies in one or more of these scopes (scopes, comma separated):
# - radius_authorize: when PacketFence receives a RADIUS request
# - external_portal: when an endpoint hits the captive portal for web authentication
# - instantiate_module: when PacketFence instantiates a switch module
# - reevaluate: when PacketFence re-evaluates the access of a device
#
# Rule
# ----
# [NAME_OF_THE_RULE]
# status = enabled
# description = What the rule does
# scopes = SCOPE1,SCOPE2
# condition = CONDITION
# switch = SWITCH_MODULE
# param.0 = SWITCH_PARAMETER=VALUE
# param.1 = SWITCH_PARAMETER=VALUE
#
# The rules are evaluated in the order of the file, the first one whose
# condition matches applies.
#
# switch: the switch module to use, for example Fortinet::FortiGate. It is only
#   used in the instantiate_module and external_portal scopes.
#
# param.N: a switch configuration parameter to override, as NAME=VALUE (for
#   example ExternalPortalEnforcement=N). The parameters only apply in the
#   radius_authorize and reevaluate scopes. A parameter holding several values,
#   like the VLAN of each role, takes KEY => VALUE pairs separated by ";":
#   vlans=gaming => 40;registration => 10
#   The value can use the attributes of the request, as $mac or ${node_info.category}.
#
# A rule can list several scopes and have both a switch module and parameters:
# the module is used when the switch is instantiated or an external portal
# request is identified, the parameters when a RADIUS request is authorized or
# the access of a device is re-evaluated.
#
# Condition
# ---------
# A condition compares attributes with values, and can be combined with
# && (and), || (or), ! (not) and parentheses:
#   ssid == "Test" && node_info.status != "reg"
#
# Comparison operators: == != =~ (regex) !~ (regex does not match) < <= > >=
# Functions:
#   defined(ATTRIBUTE), not_defined(ATTRIBUTE)
#   contains(ATTRIBUTE, "value"), not_contains(ATTRIBUTE, "value")
#   starts_with(ATTRIBUTE, "value"), ends_with(ATTRIBUTE, "value")
#   includes(ATTRIBUTE, "value") (one of the values of a list)
#   date_is_before(ATTRIBUTE, "date"), date_is_after(ATTRIBUTE, "date")
#     (the date is "YYYY-MM-DD HH:MM:SS", "YYYY-MM-DD HH:MM", "YYYY-MM-DD" or
#      "now" for the time of the evaluation)
#   fingerbank_device_is_a(ATTRIBUTE, "device")
#   time_period("period")
#   true()
#
###############################
# For the radius_authorize scope, the condition can use:
#     node_info.autoreg
#     node_info.status
#     node_info.bypass_vlan
#     node_info.bandwidth_balance
#     node_info.regdate
#     node_info.bypass_role
#     node_info.device_class
#     node_info.device_type
#     node_info.device_version
#     node_info.device_score
#     node_info.pid
#     node_info.machine_account
#     node_info.category
#     node_info.mac
#     node_info.last_dhcp
#     node_info.user_agent
#     node_info.computername
#     node_info.dhcp_fingerprint
#     node_info.detect_date
#     node_info.voip
#     node_info.notes
#     node_info.time_balance
#     node_info.sessionid
#     node_info.dhcp_vendor
#     node_info.unregdate
#     fingerbank_info.device_fq
#     fingerbank_info.device_hierarchy_names
#     fingerbank_info.device_hierarchy_ids
#     fingerbank_info.score
#     fingerbank_info.version
#     fingerbank_info.mobile
#     switch._switchIp
#     switch._ip
#     switch._portalURL
#     switch._switchMac
#     switch._ip
#     ifIndex
#     mac
#     connection_type
#     user_name
#     ssid
#     time
#     owner.pid
#     owner.firstname
#     owner.lastname
#     owner.email
#     owner.telephone
#     owner.company
#     owner.address
#     owner.notes
#     owner.sponsor
#     owner.anniversary
#     owner.birthday
#     owner.gender
#     owner.lang
#     owner.nickname
#     owner.cell_phone
#     owner.work_phone
#     owner.title
#     owner.building_number
#     owner.apartment_number
#     owner.room_number
#     owner.custom_field_1
#     owner.custom_field_2
#     owner.custom_field_3
#     owner.custom_field_4
#     owner.custom_field_5
#     owner.custom_field_6
#     owner.custom_field_7
#     owner.custom_field_8
#     owner.custom_field_9
#     owner.portal
#     owner.source
#     owner.nodes
#     owner.password
#     owner.valid_from
#     owner.expiration
#     owner.access_duration
#     owner.access_level
#     owner.can_sponsor
#     owner.unregdate
#     owner.category
#     radius_request
#     params
#
# Values:
# - connection_type
#     Wireless-802.11-EAP
#     Wireless-802.11-NoEAP
#     Ethernet-EAP
#     Ethernet-NoEAP
#     SNMP-Traps
#     Inline
# - radius_request.ATTRIBUTE
#     All the attributes of the RADIUS request (run FreeRADIUS in debug mode to see them)
# - params.ATTRIBUTE
#     The parameters in the URI when the device hits the portal (external_portal scope)
#
###############################
# For the instantiate_module scope, the condition can use:
#     radius_request (when used in the context of a RADIUS request)
#     locationlog (when used outside of the context of a RADIUS request)
#
# Attribute can be:
# - for the radius_request
#     All the attributes you can have in the RADIUS request (run FreeRADIUS in debug mode to see these attributes)
# - for the locationlog
#     id
#     mac
#     switch
#     port
#     vlan
#     role
#     connection_type
#     connection_sub_type
#     dot1x_username
#     ssid
#     start_time
#     end_time
#     switch_ip
#     switch_mac
#     stripped_user_name
#     realm
#     session_id
#     ifDesc
#
###############################
# EXAMPLES
# --------
# - If the SSID is Test, override ExternalPortalEnforcement, VlanMap and the VLAN of two roles
#
#[ssid_test]
#status=enabled
#description=Different settings for the Test SSID
#scopes=radius_authorize
#condition=ssid == "Test"
#param.0=ExternalPortalEnforcement=N
#param.1=VlanMap=Y
#param.2=vlans=gaming => 40;registration => 10
#
# - If the device is registered and not on the Test SSID, disable the external portal enforcement
#
#[registered_not_test]
#status=enabled
#description=No external portal for registered devices
#scopes=radius_authorize
#condition=ssid != "Test" && node_info.status == "reg"
#param.0=ExternalPortalEnforcement=N
#
# - If the device hits the portal with these parameters in the URI, use the Fortinet::FortiGate switch module
#
#[fortigate_portal]
#status=enabled
#description=FortiGate external portal
#scopes=external_portal
#condition=defined(params.login) && defined(params.post) && defined(params.magic) && defined(params.usermac) && defined(params.apmac) && defined(params.apip) && defined(params.userip)
#switch=Fortinet::FortiGate
#
# - If the device authenticates on a wireless connection, use the Cisco::Cisco_WLC_AireOS module
#
#[wireless_module]
#status=enabled
#description=Wireless module for the wireless connections
#scopes=instantiate_module
#condition=radius_request.NAS-Port-Type =~ "^Wireless" || locationlog.connection_type =~ "^Wireless"
#switch=Cisco::Cisco_WLC_AireOS
