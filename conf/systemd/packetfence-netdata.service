[Unit]
Description=PacketFence Netdata Monitoring
Wants=packetfence-base.target packetfence-config.service packetfence-firewalld.service
After=packetfence-base.target packetfence-config.service packetfence-firewalld.service

[Service]
StartLimitBurst=3
StartLimitInterval=10
Type=simple
TimeoutStopSec=0
TimeoutStartSec=0
ExecStartPre=/bin/mkdir -p /var/cache/netdata
ExecStartPre=/usr/bin/perl -I/usr/local/pf/lib -I/usr/local/pf/lib_perl/lib/perl5 '-Mpf::services::manager::netdata' -e 'pf::services::manager::netdata->new()->generateConfig()'
ExecStart=/usr/local/pf/sbin/netdata-docker-wrapper
ExecStop=/bin/bash -c "docker stop netdata ; docker container rm netdata -f ; echo Stopped"
PermissionsStartOnly=true

TimeoutSec=60

# restart netdata if it crashes
Restart=on-failure
Slice=packetfence.slice
PIDFile=/usr/local/pf/var/run/netdata-systemd-notify.pid

# Firewalld
ExecStartPre=/bin/perl -I/usr/local/pf/lib -I/usr/local/pf/lib_perl/lib/perl5/ -Mpf::firewalld -Mpf::db -Mpf::config -e 'print pf::firewalld::fd_netdata_rules("add")'
ExecStopPost=/bin/perl -I/usr/local/pf/lib -I/usr/local/pf/lib_perl/lib/perl5/ -Mpf::firewalld -Mpf::db -Mpf::config -e 'print pf::firewalld::fd_pfdns_rules("remove")'


[Install]
WantedBy=packetfence.target
