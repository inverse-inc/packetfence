[Unit]
Description=PacketFence GO DNS Cloud Server Daemon
Wants=packetfence-keepalived.service packetfence-base.target packetfence-config.service packetfence-iptables.service
After=packetfence-keepalived.service packetfence-base.target packetfence-config.service packetfence-iptables.service
Before=packetfence-httpd.portal.service

[Service]
Type=notify
TimeoutStopSec=60
NotifyAccess=all
ExecStartPre=/bin/perl -I/usr/local/pf/lib -I/usr/local/pf/lib_perl/lib/perl5 '-Mpf::services::manager::pfpki' -e 'pf::services::manager::pfdns->new()->generateConfig()'
ExecStart=/usr/local/pf/sbin/pfdns-cloud-docker-wrapper
ExecStop=/bin/bash -c "docker stop pfdns-cloud ; echo Stopped"
Restart=on-failure
Slice=packetfence.slice
PIDFile=/usr/local/pf/var/run/pfdns-cloud-systemd-notify.pid

[Install]
WantedBy=packetfence.target
