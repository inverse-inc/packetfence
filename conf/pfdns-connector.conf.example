.:53 {
    # This configuration will check in the /etc/hosts and if the fqdn match it will return the corresponding ip.
    # If it doesn't match then it will continue
    pfdnsconnector {
    }
    hosts {
        fallthrough
    }
    forward . [% MAIN_DNS %]
    cache
    errors
    log
}


[% FOREACH key IN connectors.keys %][% FOREACH domain IN connectors.$key.domains %][% domain.key %]:53 {
    forward . [% FOREACH dns IN domain.value %][% PFCONNECTOR_SERVICE_HOST %]:[% dns.value.pfconnectorport %] [% END %]
    cache
    errors
}
[% END %][% END %]
