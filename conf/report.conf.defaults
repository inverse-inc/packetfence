  WITH total AS (
    SELECT
      COUNT(1) as total
    FROM locationlog
    INNER JOIN node USING (mac)
    INNER JOIN ip4log USING (mac)
    WHERE
      ssid != ""
      AND (ip4log.end_time = 0 OR ip4log.end_time > NOW())
  )
  SELECT
    ssid,
    COUNT(1) AS nodes,
    ROUND( COUNT(1) / total.total * 100, 1) AS percent
  FROM locationlog
  INNER JOIN node USING (mac)
  INNER JOIN ip4log USING (mac),
  total
  WHERE
    ssid != ""
    AND (ip4log.end_time = 0 OR ip4log.end_time > NOW())
  GROUP BY ssid
  ORDER BY percent DESC;
EOT

