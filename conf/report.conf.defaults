[Security Events::Closed]
type=sql
description=List of closed security events on the network
columns=security_event.release_date "Release date", class.description "Security Event Name", node.status "Node status", node.mac "MAC Address", node.computername "Computer Name", node.pid "Owner", node.device_class "Device Class", node_category.name "Role"
sql= <<EOT
  SELECT
    security_event.id,
    security_event.release_date AS `Release date`,
    class.description AS `Security Event Name`,
    node.status AS `Node status`,
    node.mac AS `MAC Address`,
    node.computername AS `Computer Name`,
    node.pid AS `Owner`,
    node.device_class AS `Device Class`,
    node_category.name AS `Role`
  FROM security_event
  LEFT JOIN class ON class.security_event_id = security_event.security_event_id
  LEFT JOIN node ON security_event.mac = node.mac
  LEFT JOIN node_category ON node_category.category_id = node.category_id
  WHERE
    security_event.status = 'closed'
    AND security_event.start_date BETWEEN ? AND ?
    AND security_event.id <= ?
  ORDER BY security_event.id DESC
  LIMIT ?;
EOT
bindings=start_date,end_date,cursor,limit
has_date_range=enabled
has_limit=enabled
cursor_type=field
cursor_field=id
cursor_default=18446744073709551615
default_limit=25
node_fields=MAC Address
person_fields=Owner
charts=scatter|Release date

