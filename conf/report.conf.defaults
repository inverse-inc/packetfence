  FROM locationlog
    INNER JOIN node USING(mac)
    INNER JOIN ip4log USING(mac),
    total
  WHERE
    node.status = "reg"
    AND (ip4log.end_time = 0 OR ip4log.end_time > NOW())
  GROUP BY connection_type
  ORDER BY percent DESC;
EOT

