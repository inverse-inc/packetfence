[%- BLOCK chain_rules -%]
[% FOREACH rule IN rules -%]
[% IF rule -%]-A [% chain %] [% rule %] [% IF comment %]/* [% comment %] */[% END %]
[% END -%]
[% END -%]
[%- END -%]

# Copyright (C) Inverse inc.
# iptables template
# This file is manipulated on PacketFence's startup before being given to iptables

# ========================================
# Merged Firewall Configurations
# ========================================
# Includes rules from:
[% FOREACH name IN configs.keys.sort -%]
# - [% name %]
[% END -%]
# Generated on [% USE date; date.format(date.now, '%Y-%m-%d %H:%M:%S') %]


## filter table ##
*filter

### filter INPUT chain ###
:INPUT DROP [0:0]

%%input_conf_inc_rules%%

# accept loopback stuff
-A INPUT --in-interface lo --jump ACCEPT
# accept packets from the docker containers as if they were on lo
-A INPUT --in-interface docker0 --jump ACCEPT
# accept anything related
-A INPUT --match state --state ESTABLISHED,RELATED --jump ACCEPT
# Accept Ping (easier troubleshooting)
-A INPUT --protocol icmp --icmp-type echo-request --jump ACCEPT

# Docker related rules
-N DOCKER
-N DOCKER-ISOLATION-STAGE-1
-N DOCKER-ISOLATION-STAGE-2
-N DOCKER-USER
-A FORWARD -j DOCKER-USER
-A FORWARD -j DOCKER-ISOLATION-STAGE-1
-A FORWARD -o docker0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -o docker0 -j DOCKER
-A FORWARD -i docker0 ! -o docker0 -j ACCEPT
-A FORWARD -i docker0 -o docker0 -j ACCEPT
-A DOCKER-ISOLATION-STAGE-1 -i docker0 ! -o docker0 -j DOCKER-ISOLATION-STAGE-2
-A DOCKER-ISOLATION-STAGE-1 -j RETURN
-A DOCKER-ISOLATION-STAGE-2 -o docker0 -j DROP
-A DOCKER-ISOLATION-STAGE-2 -j RETURN
-A DOCKER-USER -j RETURN

[% INCLUDE chain_rules chain='INPUT' rules=merged.filter.INPUT %]

### filter FORWARD chain ###
:FORWARD DROP [0:0]

[% INCLUDE chain_rules chain='FORWARD' rules=merged.filter.FORWARD %]

### filter OUTPUT chain ###
:OUTPUT ACCEPT [0:0]

[% INCLUDE chain_rules chain='OUTPUT' rules=merged.filter.OUTPUT %]

COMMIT


## mangle table ##
*mangle

### mangle PREROUTING chain ###
:PREROUTING ACCEPT [0:0]
#%%mangle_prerouting_inline%%
[% INCLUDE chain_rules chain='PREROUTING' rules=merged.mangle.PREROUTING %]

### mangle INPUT chain ###
:INPUT ACCEPT [0:0]
[% INCLUDE chain_rules chain='INPUT' rules=merged.mangle.INPUT %]

### mangle FORWARD chain ###
:FORWARD ACCEPT [0:0]
[% INCLUDE chain_rules chain='FORWARD' rules=merged.mangle.FORWARD %]

### mangle OUTPUT chain ###
:OUTPUT ACCEPT [0:0]
[% INCLUDE chain_rules chain='OUTPUT' rules=merged.mangle.OUTPUT %]

### mangle POSTROUTING chain ###
:POSTROUTING ACCEPT [0:0]
#%%mangle_postrouting_inline%%
#%%mangle_if_src_to_chain%%
[% INCLUDE chain_rules chain='POSTROUTING' rules=merged.mangle.POSTROUTING %]

COMMIT

## nat table ##
*nat

### nat PREROUTING chain ###
:PREROUTING ACCEPT [0:0]
#%%nat_prerouting_inline%%
#%%nat_prerouting_vlan%%
[% INCLUDE chain_rules chain='PREROUTING' rules=merged.nat.PREROUTING %]

### nat OUTPUT chain ###
:OUTPUT ACCEPT [0:0]
#%%nat_if_src_to_chain%%
[% INCLUDE chain_rules chain='OUTPUT' rules=merged.nat.OUTPUT %]

### nat POSTROUTING chain ###
:POSTROUTING ACCEPT [0:0]
#%%nat_postrouting_inline%%
#%%routed_postrouting_inline%%
#%%nat_postrouting_vlan%%
[% INCLUDE chain_rules chain='POSTROUTING' rules=merged.nat.POSTROUTING %]

-N DOCKER
-A PREROUTING -m addrtype --dst-type LOCAL -j DOCKER
-A OUTPUT ! -d 127.0.0.0/8 -m addrtype --dst-type LOCAL -j DOCKER
-A POSTROUTING -s 100.64.0.0/10 ! -o docker0 -j MASQUERADE
-A DOCKER -i docker0 -j RETURN

COMMIT

