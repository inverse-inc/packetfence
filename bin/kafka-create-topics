#!/usr/bin/perl

=head1 NAME

kafka-create-topics - create the Kafka topic pfflow consumes, once the broker answers

=head1 DESCRIPTION

pfflow must not join its consumer group before its read_topic exists: Kafka
then gives it no partition and, with no other member in the group, never
rebalances (INV-948). pfflow waits for the topic itself; creating it here lets
it start consuming as soon as Kafka is up instead of after the first exported
flow auto-creates the topic. The topic gets the broker defaults for the
partition count and replication factor, as auto-creation would. Nothing is
created while the pfflow task is disabled, or when none of its kafka_brokers is
this host's Kafka (pfflow then reads from another cluster, where a topic
created here would not help).

Run as ExecStartPost of packetfence-kafka.service. The whole run, pfconfig
lookup included, stays within KAFKA_CREATE_TOPICS_TIMEOUT seconds (plus a few
seconds if docker itself hangs) so the unit's start timeout, which also covers
its ExecStartPre steps, is not reached. Each kafka-topics attempt is capped at
KAFKA_CREATE_TOPICS_ATTEMPT_TIMEOUT seconds, so an AdminClient stuck on a
broker that is not ready yet fails and is retried.

=cut

use strict;
use warnings;

use lib qw(/usr/local/pf/lib /usr/local/pf/lib_perl/lib/perl5);

use Socket qw(getaddrinfo getnameinfo NI_NUMERICHOST NIx_NOSERV SOCK_STREAM);
use Sys::Hostname qw(hostname);

my $container       = 'kafka';
my $port            = 9095;
my $attempt_timeout = $ENV{KAFKA_CREATE_TOPICS_ATTEMPT_TIMEOUT} || 15;
my $budget          = $ENV{KAFKA_CREATE_TOPICS_TIMEOUT} || 60;
my $deadline        = time() + $budget;

# This host's names and addresses, filled on the first is_local_broker call.
my (%local_names, %local_addrs);

$| = 1;

my ($enabled, $topic, @brokers) = read_pfflow_config();
if (!$enabled) {
    print "pfflow is disabled, not creating its Kafka topic\n";
    exit 0;
}

if (!grep { is_local_broker($_) } @brokers) {
    my $list = @brokers ? join(',', @brokers) : 'no broker';
    print "pfflow reads from $list, not from this host's Kafka, not creating its topic here\n";
    exit 0;
}

my $last_error = "broker not listening on port $port";
while (1) {
    my $left = $deadline - time();
    if ($left <= 0) {
        print STDERR "Unable to create Kafka topic $topic within ${budget}s ($last_error), pfflow will wait for it\n";
        exit 1;
    }

    # Start the kafka-topics JVM only once the broker listens, and bound it
    # inside the container: a timeout on the docker client alone would leave
    # the JVM running next to a broker that is still starting.
    my ($listening) = run_cmd('timeout', $left, 'docker', 'exec', $container, 'bash', '-c', "exec 3<>/dev/tcp/localhost/$port");
    if ($listening) {
        $left = $deadline - time();
        if ($left > 0) {
            my $limit = $left < $attempt_timeout ? $left : $attempt_timeout;
            my ($ok, $out) = run_cmd(
                'timeout', $limit + 5, 'docker', 'exec', $container, 'timeout', $limit,
                'kafka-topics', '--bootstrap-server', "localhost:$port", '--create', '--if-not-exists', '--topic', $topic,
            );
            if ($ok) {
                print "Kafka topic $topic is present\n";
                exit 0;
            }

            my @lines = grep { /\S/ } split /\n/, $out;
            $last_error = @lines ? $lines[-1] : "kafka-topics exited with status " . ($? >> 8);
        }
    }

    sleep 2;
}

=head2 read_pfflow_config

Returns whether the pfflow task is enabled, its read_topic and its
kafka_brokers, within the time budget. Exits 1 if pfconfig does not answer or
the configuration is unusable.

=cut

sub read_pfflow_config {
    my @config = eval {
        local $SIG{ALRM} = sub { die "pfconfig did not answer within ${budget}s\n" };
        alarm $budget;
        require pf::config::pfcron;
        require pf::util;
        no warnings 'once';
        my $c = $pf::config::pfcron::ConfigCron{pfflow}
          or die "no pfflow task in the pfcron configuration\n";
        my $b = $c->{kafka_brokers} // [];
        my @list = ref $b ? @$b : split /\s*,\s*/, $b;
        alarm 0;
        (pf::util::isenabled($c->{status}) ? 1 : 0, $c->{read_topic} // '', grep { length } @list);
    };
    alarm 0;
    if (!@config || ($config[0] && $config[1] eq '')) {
        my $why = $@ || "no read_topic\n";
        print STDERR "Unable to read the pfflow configuration, not creating its Kafka topic: $why";
        exit 1;
    }

    return @config;
}

=head2 is_local_broker

Reports whether a pfflow broker (HOST:PORT) is this host's Kafka: its PF
listener (port 9095) under one of the names it is known by, or under a name
resolving to one of this host's addresses (an alias such as the
KAFKA_ADVERTISED_LISTENER_PF value, which is not set in this unit).

=cut

sub is_local_broker {
    my ($broker) = @_;
    my ($host, $broker_port) = $broker =~ /^\[?(.*?)\]?:(\d+)$/ or return 0;
    $host = lc $host;
    return 0 if $host eq '' || $broker_port != $port;

    if (!%local_names) {
        %local_names = map { lc($_) => 1 } grep { defined && length } (
            'containers-gateway.internal', 'localhost', hostname(),
            command_output('hostname', '-f'), $ENV{KAFKA_ADVERTISED_LISTENER_PF},
        );
        %local_addrs = map { $_ => 1 } ('127.0.0.1', '::1', split ' ', command_output('hostname', '-I'));
    }

    return 1 if $local_names{$host} || $local_addrs{$host};

    my ($err, @res) = getaddrinfo($host, undef, { socktype => SOCK_STREAM });
    return 0 if $err;
    for my $ai (@res) {
        my ($nerr, $addr) = getnameinfo($ai->{addr}, NI_NUMERICHOST, NIx_NOSERV);
        return 1 if !$nerr && $local_addrs{$addr};
    }

    return 0;
}

=head2 run_cmd

Runs a command with stdout and stderr captured together. Returns whether it
exited with status 0 and its output.

=cut

sub run_cmd {
    my @cmd = @_;
    my $pid = open(my $fh, '-|');
    if (!defined $pid) {
        return (0, "cannot fork: $!");
    }

    if ($pid == 0) {
        open(STDERR, '>&', \*STDOUT);
        exec { $cmd[0] } @cmd or do { print "cannot run $cmd[0]: $!\n"; exit 127 };
    }

    my $out = do { local $/; <$fh> } // '';
    close $fh;
    return ($? == 0, $out);
}

=head2 command_output

Returns the trimmed output of a command, or an empty string if it failed.

=cut

sub command_output {
    my ($ok, $out) = run_cmd(@_);
    return '' if !$ok;
    $out =~ s/^\s+|\s+$//g;
    return $out;
}

